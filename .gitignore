/sis-database/volume/

# Per-deployment secrets — never commit. Use .env.example as a template.
.env

# Working notes, not for the public repo
PRODUCTION-PLAN.md
RASTER-AND-DST-PLAN.md
docker-compose.override.yml

# Runtime raster / metadata artifacts. These bind-mounted dirs hold per-instance
# state — registered rasters (.tif), MapServer .map files and pyCSW .xml records
# regenerated by register_raster, plus GDAL sidecars and DST caches. They churn
# constantly and differ per country, so they are not source. Keep only the
# mount-point dirs (via .gitkeep).
/sis-web-services/volume/*
!/sis-web-services/volume/.gitkeep
/sis-metadata/volume/*
!/sis-metadata/volume/.gitkeep
